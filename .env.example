TARGET_NAME=
TARGET_URL=
REQUIRED_TEXT=
# or, instead of REQUIRED_TEXT:
REQUIRED_ROLE=
REQUIRED_NAME=

# The overall heartbeat: how often pulse, render, and the cheap authed check ALL run,
# every cycle, no matter what session/login state anything is in. Not the same clock as
# LOGIN_INTERVAL_S further down (that one only throttles real, full logins) -- see its
# comment for the distinction.
CHECK_INTERVAL_S=60
BROWSER_TIMEOUT_MS=15000

RECIPIENTS_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

DASHBOARD_USER=
DASHBOARD_PASSWORD=
PORT=8080
DB_PATH=./data/monitor.db
BROWSER_CHANNEL=chrome
HEADLESS=true

# --- Stage 4: alert channels ---
# comma-separated list of enabled channels: email, sms
ALERT_CHANNELS=email

# --- SMS channel (Twilio) --- core (config.py) never reads these; monitor/channels/sms_twilio.py does
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# comma-separated list of recipient numbers
SMS_TO_NUMBER=
# optional: required on Twilio trial accounts (freeform body sends are rejected there).
# Set to an approved Content Template's SID (HXxxxxxxxx...) with a single {{1}} variable.
TWILIO_CONTENT_SID=

# --- SMS-via-email-gateway (testing only, no Twilio account needed) ---
# comma-separated list of <10-digit number>@<carrier gateway domain>, e.g.
# 5551234567@vtext.com (Verizon), @txt.att.net (AT&T), @tmomail.net (T-Mobile),
# @vmobl.com (Visible). Uses GMAIL_USER/GMAIL_APP_PASSWORD above -- no separate creds.
SMS_GATEWAY_ADDRESS=

# --- Stage 5: fast detection (confirmation burst + confidence scoring) ---
# [v3.1] DOWN requires score >= DOWN_CONFIDENCE AND >= MIN_FAILED_PROBES distinct failed
# probes within BURST_WINDOW_S, no intervening pass. BURST_DELAYS_S/JITTER_S/WINDOW_S are
# shared by both status tracks (main and auth, see AUTH_DOWN_CONFIDENCE/
# AUTH_MIN_FAILED_PROBES further down); DOWN_CONFIDENCE/MIN_FAILED_PROBES below apply
# specifically to the MAIN track (pulse/render, "is the login page reachable").
BURST_DELAYS_S=0,15,35,55
BURST_JITTER_S=5
BURST_WINDOW_S=90
DOWN_CONFIDENCE=4
MIN_FAILED_PROBES=3

# --- Stage 6: sign-in journey (security-team test site ONLY) ---
LOGIN_URL=
# [v3.8 / Stage R] The authenticated home URL the cheap session-reuse check navigates to
# directly (e.g. https://.../dbank/beta/app/home) -- never derived from LOGIN_URL. The
# login route and the authed-home route depend on different backends, so testing them
# independently is real, distinct evidence (Rule 16).
AUTHED_URL=
LOGIN_USER=
LOGIN_PASSWORD=
# MFA_ENABLED describes the SITE (does this bank require a 2nd factor after the
# password?), not a testing toggle -- set once, based on the target, and leave it.
MFA_ENABLED=true
# How the automated loop answers an MFA prompt by itself: a captured authenticator-app
# secret, generates a fresh code each attempt. Required whenever MFA_ENABLED is true,
# UNLESS ALLOW_MFA_UNCONFIGURED (below) is explicitly turned on for testing.
TOTP_SECRET=                      # captured at authenticator enrollment ("can't scan?")
# YOUR testing toggle, not a site property -- off by default. With TOTP_SECRET blank and
# this true, the auth track is still allowed to START (session-reuse checks work
# normally every cycle, no MFA involved), but any recovery login it does eventually need
# can't complete MFA and cleanly reports mfa_failed -> CONFIG_ERROR instead of refusing
# to start at all or crashing. Recover by running scripts/run_signin_drill.py
# --keep-session (pauses for you to complete MFA by hand). Production requires a real
# TOTP_SECRET and this set back to false -- never leave this true unattended.
ALLOW_MFA_UNCONFIGURED=false
AUTHED_REQUIRED_TEXT=             # or AUTHED_REQUIRED_ROLE + AUTHED_REQUIRED_NAME
AUTHED_REQUIRED_ROLE=
AUTHED_REQUIRED_NAME=
ERROR_BANNER_TEXT=                # must be ABSENT for auth to pass
MASK_TEXT=                        # semicolon-separated regex patterns masked from post-login screenshots, e.g. \$[\d,]+\.\d{2}
MASKING_ENABLED=true              # keep true; only false for a confirmed no-PII test target
# [v3.2] patchright is a named, scoped exception to Rule 12 for this journey only.
# [v3.3] journey always runs headed under xvfb, never honors HEADLESS above.
CHALLENGE_TIMEOUT_MS=25000
# [v3] Stages 6-7 only; deleted at Stage 8 (Rule 11). Not yet wired to any behavior.
LOGIN_STRESS_MODE=false

# --- Stage 8: session reuse (pulled forward -- see CLAUDE.md v3.7) ---
# SESSION_STATE_PATH is a real secret (chmod 600, gitignored): storageState saved after
# a successful full login, reused by the cheap every-CHECK_INTERVAL_S authed check --
# this is WHAT gets reused.
SESSION_STATE_PATH=./data/session_state.json
# HOW LONG that file is trusted before being treated as stale, purely by its age on disk
# (not by asking the bank). Once older than this, the cheap check is skipped and a real
# recovery login is attempted instead. Different clock from LOGIN_INTERVAL_S below (that
# limits how often a LOGIN can be attempted; this limits how long a SESSION is trusted).
# 1800s/30min here is a conservative, hand-picked default -- Stage 7's soak should
# replace it with the real measured session lifetime.
SESSION_MAX_AGE_S=1800
# Minimum seconds between two real, full (credential + MFA) login attempts -- NOT the
# same thing as CHECK_INTERVAL_S (which runs every cycle regardless). This only throttles
# the rare, expensive/risky case where a fresh login is actually needed. Conservative,
# hand-picked (no measured safe rate yet) -- Stage 7's soak should replace this with a
# measured value.
LOGIN_INTERVAL_S=1800
# A second, independent limit (Rule 11 -- both this and LOGIN_INTERVAL_S must pass for a
# login attempt to proceed). LOGIN_INTERVAL_S alone would still permit up to
# 86400/LOGIN_INTERVAL_S logins/day if it needed to recover constantly -- this is a real,
# lower ceiling on top of that, catching a persistent slow-grind pattern that
# LOGIN_INTERVAL_S's burst protection alone wouldn't.
MAX_LOGINS_PER_DAY=60
# [v3.8 / Stage R] The AUTH track's (not main's -- see DOWN_CONFIDENCE/MIN_FAILED_PROBES
# above) own DOWN_CONFIDENCE/MIN_FAILED_PROBES pair. Now bursts like the main track
# (cheap, zero-login re-probes), so it uses the same floor. See config.py.
AUTH_DOWN_CONFIDENCE=4
AUTH_MIN_FAILED_PROBES=3
