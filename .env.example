TARGET_NAME=
TARGET_URL=
REQUIRED_TEXT=
# or, instead of REQUIRED_TEXT:
REQUIRED_ROLE=
REQUIRED_NAME=

CHECK_INTERVAL_S=60
BROWSER_TIMEOUT_MS=15000

RECIPIENTS_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

DASHBOARD_USER=
DASHBOARD_PASSWORD=
PORT=8080
DB_PATH=./data/monitor.db
BROWSER_CHANNEL=chrome
HEADLESS=true

# --- Stage 4: alert channels ---
# comma-separated list of enabled channels; "sms" is a contribution seam, not yet implemented
ALERT_CHANNELS=email
# SMS_* vars will be defined by the SMS PR; core never reads them directly

# --- Stage 5: fast detection (confirmation burst + confidence scoring) ---
# [v3.1] DOWN requires score >= DOWN_CONFIDENCE AND >= MIN_FAILED_PROBES distinct failed
# probes within BURST_WINDOW_S, no intervening pass.
BURST_DELAYS_S=0,15,35,55
BURST_JITTER_S=5
BURST_WINDOW_S=90
DOWN_CONFIDENCE=4
MIN_FAILED_PROBES=3
