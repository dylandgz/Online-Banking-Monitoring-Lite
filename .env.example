TARGET_NAME=
TARGET_URL=
REQUIRED_TEXT=
# or, instead of REQUIRED_TEXT:
REQUIRED_ROLE=
REQUIRED_NAME=

CHECK_INTERVAL_S=60
BROWSER_TIMEOUT_MS=15000

RECIPIENTS_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

DASHBOARD_USER=
DASHBOARD_PASSWORD=
PORT=8080
DB_PATH=./data/monitor.db
BROWSER_CHANNEL=chrome
HEADLESS=true

# --- Stage 4: alert channels ---
# comma-separated list of enabled channels: email, sms
ALERT_CHANNELS=email

# --- SMS channel (Twilio) --- core (config.py) never reads these; monitor/channels/sms_twilio.py does
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# comma-separated list of recipient numbers
SMS_TO_NUMBER=
# optional: required on Twilio trial accounts (freeform body sends are rejected there).
# Set to an approved Content Template's SID (HXxxxxxxxx...) with a single {{1}} variable.
TWILIO_CONTENT_SID=

# --- SMS-via-email-gateway (testing only, no Twilio account needed) ---
# comma-separated list of <10-digit number>@<carrier gateway domain>, e.g.
# 5551234567@vtext.com (Verizon), @txt.att.net (AT&T), @tmomail.net (T-Mobile),
# @vmobl.com (Visible). Uses GMAIL_USER/GMAIL_APP_PASSWORD above -- no separate creds.
SMS_GATEWAY_ADDRESS=

# --- Stage 5: fast detection (confirmation burst + confidence scoring) ---
# [v3.1] DOWN requires score >= DOWN_CONFIDENCE AND >= MIN_FAILED_PROBES distinct failed
# probes within BURST_WINDOW_S, no intervening pass.
BURST_DELAYS_S=0,15,35,55
BURST_JITTER_S=5
BURST_WINDOW_S=90
DOWN_CONFIDENCE=4
MIN_FAILED_PROBES=3
